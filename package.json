{
  "name": "termdock",
  "version": "1.4.364",
  "description": "A complete web-based terminal application with modern UI",
  "type": "module",
  "main": ".desktop-dist/main.js",
  "bin": {
    "termdock": "dist/server/cli.js",
    "td": "dist/server/cli.js"
  },
  "exports": {
    ".": "./dist/server/entry.js"
  },
  "files": [
    "THIRD_PARTY_NOTICES.md",
    "dist",
    "runtime-manifest.json",
    "README.md",
    "docs/systemd.md",
    "packaging/systemd/termdock.service.d/10-preserve-tmux.conf",
    "LICENSE",
    "scripts",
    "docs/integrations.md"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "vite",
    "dev:server": "cross-env PORT=9835 tsx watch src/server/entry.ts",
    "build": "npm run clean && npm run build:client && npm run build:server && npm run build:runtime-manifest",
    "build:desktop": "rimraf .desktop-dist && node scripts/prepare-desktop-tokens.mjs && tsc -p tsconfig.desktop.json && esbuild desktop/preload.cts --bundle --platform=node --format=cjs --external:electron --outfile=.desktop-dist/preload.cjs && esbuild desktop/renderer/services.tsx --bundle --platform=browser --format=iife --minify --outfile=desktop/renderer/services.js",
    "desktop:dev": "npm run build && npm run build:desktop && electron-forge start",
    "desktop:prepare": "npm run build && npm run build:desktop",
    "desktop:make": "node scripts/ensure-macos-appdmg.mjs && npm run desktop:prepare && electron-forge make",
    "build:client": "vite build && node scripts/precompress-client.mjs",
    "build:server": "tsc -p tsconfig.server.json && node -e \"require('fs').chmodSync('dist/server/cli.js', 0o755)\"",
    "build:runtime-manifest": "node scripts/generate-runtime-manifest.mjs",
    "generate:chat-ui-catalog": "node scripts/generate-chat-ui-catalog.mjs",
    "generate:pwa-assets": "pwa-assets-generator --config pwa-assets.config.ts",
    "preview": "vite preview",
    "start": "node dist/server/cli.js",
    "lint": "tsc --noEmit",
    "trace:diff": "node scripts/inspect-diff-trace.mjs",
    "trace:fsio": "node scripts/inspect-fs-io.mjs",
    "release:classify": "node scripts/classify-release.mjs",
    "test": "vitest --passWithNoTests",
    "test:initialization": "node --test tests/nodePtyInstall.test.mjs tests/installUtils.test.mjs && node --import tsx --test tests/initialization.process.test.mjs && vitest run --maxWorkers=2 src/server/utils/bootCheck.test.ts src/server/utils/localHttpsSetup.test.ts src/server/utils/nodePtyCleanup.test.ts src/server/utils/npmUpdate.test.ts",
    "test:initialization:real": "node --import tsx --test tests/initialization.real.test.mjs",
    "test:webgl": "vitest run --config vitest.webgl.config.ts",
    "test:terminal-geometry": "vitest run src/lib/terminal/geometry.test.ts src/lib/terminal/geometryBoundary.test.ts src/lib/terminal/fitHysteresis.test.ts src/lib/terminal/api.continuousReconnect.test.ts src/lib/components/terminal/TerminalViewportPasteOwnership.test.tsx src/lib/federation/SessionAccessView.test.tsx src/server/utils/tmuxDisplayGeometry.test.ts src/server/utils/tmuxObserverSize.test.ts src/server/utils/tmuxSizeOwnership.test.ts src/server/utils/terminalHandshakeDimensions.test.ts src/server/routes/terminalInitialSize.test.ts src/server/routes/terminalSampling.test.ts",
    "test:terminal-geometry:browser": "vitest run --config vitest.webgl.config.ts src/lib/terminal/geometry.browser.ts && vitest run --config vitest.tmux-output.config.ts",
    "test:ui": "vitest --ui",
    "test:keyboard-layout": "vitest run src/lib/components/views/TerminalView.nativePicker.test.tsx src/lib/components/layout/keyboardLayoutBoundary.test.ts src/lib/hooks/nativeKeyboardLayout.test.ts src/lib/hooks/useKeyboardFocusGuard.test.tsx src/lib/hooks/useTouchScrollBoundary.test.tsx src/lib/hooks/usePreserveInputFocus.test.tsx src/lib/hooks/useInputViewportDiagnostics.test.tsx src/lib/hooks/useViewportHeight.events.test.ts && vitest run --config vitest.chat-viewport.config.ts",
    "prepublishOnly": "npm run build",
    "postinstall": "node scripts/postinstall.mjs",
    "preview:desktop:dev": "npm --prefix desktop-rust run dev",
    "preview:desktop:build": "npm --prefix desktop-rust run build",
    "preview:desktop:test": "npm --prefix desktop-rust run verify"
  },
  "dependencies": {
    "@chainsafe/libp2p-noise": "17.0.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@hello-pangea/dnd": "^18.0.1",
    "@libp2p/crypto": "5.1.9",
    "@libp2p/interface": "3.1.0",
    "@libp2p/peer-id": "6.0.0",
    "@libp2p/utils": "7.0.7",
    "@noble/hashes": "2.4.0",
    "@novnc/novnc": "^1.7.0",
    "@openuidev/lang-core": "1.0.1",
    "@openuidev/react-lang": "1.0.1",
    "@openuidev/react-ui": "0.18.1",
    "@peculiar/x509": "2.2.0",
    "@serenity-kit/opaque": "1.1.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/csurf": "^1.11.5",
    "@types/refractor": "^2.8.0",
    "@use-gesture/react": "^10.3.1",
    "@xterm/addon-clipboard": "^0.3.0-beta.287",
    "@xterm/addon-fit": "^0.12.0-beta.287",
    "@xterm/addon-image": "^0.10.0-beta.287",
    "@xterm/addon-ligatures": "^0.11.0-beta.287",
    "@xterm/addon-progress": "^0.3.0-beta.287",
    "@xterm/addon-search": "^0.17.0-beta.287",
    "@xterm/addon-serialize": "^0.15.0-beta.287",
    "@xterm/addon-unicode11": "^0.10.0-beta.287",
    "@xterm/addon-web-links": "^0.13.0-beta.287",
    "@xterm/addon-webgl": "0.20.0-beta.309",
    "@xterm/headless": "^6.1.0-beta.287",
    "@xterm/xterm": "6.1.0-beta.315",
    "browser-haptic": "^1.0.13",
    "busboy": "^1.6.0",
    "cookie-parser": "^1.4.7",
    "dompurify": "^3.4.14",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "guacamole-common-js": "^1.5.0",
    "heic-convert": "^2.1.0",
    "katex": "^0.17.0",
    "lucide-react": "^1.17.0",
    "mermaid": "^11.17.2",
    "motion": "^12.40.0",
    "multicast-dns": "^7.2.5",
    "node-pty": "1.1.0",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-diff-view": "^3.3.3",
    "react-dom": "^18.2.0",
    "reflect-metadata": "0.2.2",
    "refractor": "^2.10.1",
    "swiper": "^12.1.3",
    "tailwind-merge": "^2.2.0",
    "three": "^0.185.1",
    "uuid": "^13.0.0",
    "web-push": "^3.6.7",
    "ws": "^8.21.0",
    "yaml": "^2.9.1",
    "zod": "4.6.7",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@testing-library/react": "^14.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/busboy": "^1.5.4",
    "@types/express": "^4.17.21",
    "@types/guacamole-common-js": "^1.5.5",
    "@types/heic-convert": "^2.1.1",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/three": "^0.185.3",
    "@types/uuid": "^10.0.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/browser-playwright": "4.1.7",
    "autoprefixer": "^10.4.0",
    "concurrently": "^8.2.0",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "es-module-shims": "^2.8.4",
    "esbuild": "^0.27.7",
    "eslint": "^9.39.2",
    "jsdom": "^24.0.0",
    "postcss": "^8.4.0",
    "rimraf": "^6.1.3",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.0.17"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "terminal",
    "termdock",
    "xterm",
    "express",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jovines/termdock.git"
  },
  "homepage": "https://github.com/Jovines/termdock#readme",
  "bugs": {
    "url": "https://github.com/Jovines/termdock/issues"
  },
  "overrides": {
    "prismjs": "^1.30.0"
  },
  "optionalDependencies": {
    "@fails-components/webtransport": "1.6.11",
    "@fails-components/webtransport-transport-http3-quiche": "1.6.11"
  }
}
