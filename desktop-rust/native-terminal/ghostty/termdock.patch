+        rt_app.opts.userdata = null;
+    }
+    var capture: Capture = .{};
+    var io: termio.Termio = undefined;
+    try io.init(alloc, .{
+        .size = .{ .screen = .{ .width = @as(u32, columns) * 10, .height = 480 }, .cell = .{ .width = 10, .height = 20 }, .padding = .{} },
+        .full_config = &cfg,
+        .config = try termio.DerivedConfig.init(alloc, &cfg),
+        .backend = .{ .external = try termio.External.init(alloc, .{
+            .write_callback = Capture.write,
+            .write_userdata = &capture,
+            .resize_callback = Capture.resize,
+            .resize_userdata = &capture,
+        }) },
+        .mailbox = try termio.Mailbox.initSPSC(alloc),
+        .renderer_state = &state,
+        .renderer_wakeup = async_render,
+        .renderer_mailbox = render,
+        .surface_mailbox = .{ .surface = &opaque_surface, .app = .{ .rt_app = &rt_app, .mailbox = app } },
+    });
+    defer io.deinit();
+    state.terminal = &io.terminal;
+    io.terminal.td_remote = true;
+    io.terminal.screens.active.td_history_rows = requested;
+    io.terminal.screens.active.pages.td_max_bytes = 32 * 1024 * 1024;
