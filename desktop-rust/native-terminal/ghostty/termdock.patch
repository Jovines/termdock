+#!/usr/bin/env python3
+"""Merge Zig archives via raw objects; CLT libtool rejects unaligned members.
+
+Read each physical member, not `ar -x` by name: dependencies contain duplicate
+names. GNU/BSD input offsets may be only 2-byte aligned. Apple libtool sees only
+standalone objects and creates its own aligned archive and symbol index. Audit
+EVERY member afterward before publishing the result, including byte hashes.
+"""
+import hashlib
+import json
+import os
+from pathlib import Path
+import struct
+import subprocess
+import sys
+import tempfile
+
+
+def members(path, require_symbols=False):
+    """Yield (physical index, name, object offset, bytes); reject malformed input."""
+    with Path(path).open('rb') as source:
+        if source.read(8) != b'!<arch>\n':
+            raise ValueError('expected regular single-architecture archive: ' + str(path))
+        strings = None
+        index = 0
+        have_symbols = False
+        while True:
+            header = source.read(60)
+            if not header:
+                if require_symbols and not have_symbols:
+                    raise ValueError("output archive has no symbol index")
+                return
+            if len(header) != 60 or header[58:] != b'`\n':
+                raise ValueError('invalid archive member header')
+            size = int(header[48:58].strip())
+            if size < 0:
+                raise ValueError('negative archive member size')
+            offset = source.tell()
+            data = source.read(size)
+            if len(data) != size:
+                raise ValueError('truncated archive member')
+            if size % 2 and len(source.read(1)) != 1:
+                raise ValueError('missing archive padding')
+            index += 1
+            name = header[:16].rstrip(b' ')
+            if name == b'//':
+                strings = data
+                continue
+            if name in (b'/', b'/SYM64/'):
+                continue
+            if name.startswith(b'#1/'):
+                length = int(name[3:])
+                if length < 0 or length > len(data):
+                    raise ValueError('invalid BSD extended name')
+                name, data = data[:length].rstrip(b'\0'), data[length:]
+                offset += length
+            elif name.startswith(b'/'):
+                if strings is None:
+                    raise ValueError('GNU name without string table')
+                start = int(name[1:])
+                if start < 0 or start >= len(strings):
+                    raise ValueError('invalid GNU name offset')
+                end = strings.find(b'\n', start)
+                if end < 0:
+                    raise ValueError('unterminated GNU name')
+                name = strings[start:end].removesuffix(b'/')
+            else:
+                name = name.removesuffix(b'/')
+            if name.startswith(b'__.SYMDEF'):
+                have_symbols = bool(data)
+                continue
+            if not name or not data:
+                raise ValueError('empty archive object/name')
+            yield index, os.fsdecode(name), offset, data
+
+
+def digest(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def merge(output, manifest_path, sources, libtool='libtool'):
+    output = Path(output).resolve()
+    output.parent.mkdir(parents=True, exist_ok=True)
+    # The temporary directory remains on the output filesystem for atomic rename.
+    with tempfile.TemporaryDirectory(prefix='td-objects-', dir=output.parent) as work:
+        work = Path(work)
+        objects = []
+        inventory = []
+        for source in sources:
+            for index, name, offset, data in members(source):
+                # td-lib is arm64; also retain the original macOS x86_64 build capability.
+                # Do not silently accept a dropped non-object.
+                if data[:4] != b'\xcf\xfa\xed\xfe' or len(data) < 32 or struct.unpack_from('<I', data, 4)[0] not in (0x0100000c, 0x01000007):
+                    raise ValueError('expected macOS 64-bit Mach-O object: ' + str(source) + ':' + name)
+                unique = 'm%08d.o' % len(objects)
+                obj = work / unique
+                obj.write_bytes(data)
+                objects.append(obj)
+                inventory.append({'source': str(source), 'index': index, 'name': name,
+                                  'input_offset': offset, 'member': unique,
+                                  'size': len(data), 'sha256': digest(data)})
+        if not objects:
+            raise ValueError('no archive objects')
+        if any('\n' in str(p) or '\r' in str(p) for p in objects):
+            raise ValueError('newline in libtool filelist path')
+        filelist = work / 'objects.list'
+        filelist.write_text(''.join(str(p) + '\n' for p in objects))
+        combined = work / output.name
+        process = subprocess.run([libtool, '-static', '-o', str(combined), '-filelist', str(filelist)],
+                                 stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
+        sys.stdout.write(process.stdout)
+        sys.stderr.write(process.stderr)
+        process.check_returncode()
+        if 'ignoring archive member' in process.stderr.lower():
+            raise ValueError('libtool ignored an archive member')
+        expected = {entry['member']: entry for entry in inventory}
+        seen = set()
+        for _, name, offset, data in members(combined, require_symbols=True):
+            if name not in expected or name in seen:
+                raise ValueError('unexpected or duplicate output member: ' + name)
+            entry = expected[name]
+            # Darwin adds <=7 zero bytes at the end of objects for 8-byte alignment.
+            size = entry['size']
+            padding = data[size:]
+            if len(data) < size or digest(data[:size]) != entry['sha256'] or len(padding) > 7 or any(padding):
+                raise ValueError('changed output object bytes: ' + name)
+            if offset % 8:
+                raise ValueError('unaligned output object: ' + name)
+            entry['output_offset'] = offset
+            entry['output_padding'] = len(padding)
+            seen.add(name)
+        if seen != set(expected):
+            raise ValueError('lost archive members: ' + str(sorted(set(expected) - seen)))
+        # Apple's own libtool creates the symbol index; actual fixture linking is
+        # still mandatory and is not replaced by this object preservation audit.
+        manifest = {'objects': len(inventory), 'library_sha256': digest(combined.read_bytes()),
+                    'members': inventory}
+        combined.replace(output)
+        Path(manifest_path).write_text(json.dumps(manifest, indent=2) + '\n')
+        print('td-lib archive: %d objects preserved, all 8-byte aligned' % len(inventory), flush=True)
+
+
+if __name__ == '__main__':
+    if len(sys.argv) < 4:
+        raise SystemExit('usage: td_libtool.py OUTPUT MANIFEST.json SOURCE.a ...')
+    merge(sys.argv[1], sys.argv[2], sys.argv[3:])
