+//! Headless engine fixture. REAL Termio/StreamHandler/External backend and
+//! bounded engine mailboxes; only the GUI wakeup is a test host callback.
+//! No surface initialization, Exec backend, PTY or renderer is started here.
+const std = @import("std");
+const termio = @import("../termio.zig");
+const renderer = @import("../renderer.zig");
+const apprt = @import("../apprt.zig");
+const App = @import("../App.zig");
+const CoreSurface = @import("../Surface.zig");
+const Config = @import("../config.zig").Config;
+const xev = @import("../global.zig").xev;
+fn wakeup(_: ?*anyopaque) callconv(.c) void {}
+const Capture = struct {
+    bytes: [4096]u8 = undefined,
+    len: usize = 0,
+    resizes: usize = 0,
+    fn write(data: []const u8, userdata: ?*anyopaque) void {
+        const self: *Capture = @ptrCast(@alignCast(userdata.?));
+        std.debug.assert(self.len + data.len <= self.bytes.len);
+        @memcpy(self.bytes[self.len..][0..data.len], data);
+        self.len += data.len;
+    }
+    fn resize(_: u16, _: u16, _: u32, _: u32, userdata: ?*anyopaque) void {
+        const self: *Capture = @ptrCast(@alignCast(userdata.?));
+        self.resizes += 1;
+    }
+};
+const Gui = struct {
+    app: *App.Mailbox.Queue,
+    calls: usize = 0,
+    messages: usize = 0,
+    fn yield(ctx: ?*anyopaque) callconv(.c) bool {
+        const self: *Gui = @ptrCast(@alignCast(ctx.?));
+        self.calls += 1;
+        while (self.app.pop()) |_| {
+            self.messages += 1;
+        }
+        return true;
+    }
+};
+fn drain(io: *termio.Termio, data: *termio.Termio.ThreadData, app: *App.Mailbox.Queue, render: *renderer.Thread.Mailbox) !void {
+    while (io.mailbox.spsc.queue.pop()) |message| switch (message) {
+        .write_small => |v| try io.queueWrite(data, v.data[0..v.len], false),
+        .write_stable => |v| try io.queueWrite(data, v, false),
+        .write_alloc => |v| {
+            defer v.alloc.free(v.data);
+            try io.queueWrite(data, v.data, false);
+        },
+        else => {},
+    };
+    while (app.pop()) |_| {}
+    while (render.pop()) |_| {}
+}
