+//! Bounded read-only cell slice for the existing page path-link matcher.
+const std=@import("std");const Terminal=@import("Terminal.zig");
+pub fn capture(t:*const Terminal,x:u16,y:u16,w:*std.Io.Writer) !void {
+ const p=&t.screens.active.pages;if(x>=p.cols or y>=p.rows)return error.InvalidPoint;
+ const clicked=p.pin(.{.viewport=.{.x=x,.y=y}}) orelse return error.InvalidPoint;
+ const pos=p.pointFromPin(.screen,clicked).?.coord();
+ const count=@min(@as(usize,64),4096/@as(usize,p.cols));if(count==0)return error.TooLarge;
+ const start=@as(usize,pos.y)-|count/2;const end=@min(p.total_rows,start+count);
+ try w.print("{{\"version\":1,\"row\":{d},\"column\":{d},\"rows\":[",.{@as(usize,pos.y)-start,x});
+ for(start..end) |row| {
+  if(row!=start)try w.writeByte(',');const pin=p.pin(.{.screen=.{.x=0,.y=@intCast(row)}}).?;
+  try w.print("{{\"wrapped\":{s},\"cells\":[",.{if(pin.rowAndCell().row.wrap_continuation) "true" else "false"});
+  for(pin.cells(.all),0..) |*cell,i| {
+   if(i!=0)try w.writeByte(',');var text:[4096]u8=undefined;var tw=std.Io.Writer.fixed(&text);
+   const width:u8=switch(cell.wide){.wide=>2,.spacer_tail,.spacer_head=>0,.narrow=>1};
+   if(width>0){const cp=cell.codepoint();var bytes:[4]u8=undefined;const len=std.unicode.utf8Encode(if(cp==0) ' ' else cp,&bytes) catch return error.InvalidCodepoint;try tw.writeAll(bytes[0..len]);
+    if(pin.node.data.lookupGrapheme(cell)) |cps| for(cps) |grapheme| {const n=std.unicode.utf8Encode(grapheme,&bytes) catch return error.InvalidCodepoint;try tw.writeAll(bytes[0..n]);};
+   }
+   const style=if(cell.style_id!=0) pin.node.data.styles.get(pin.node.data.memory,cell.style_id).* else @import("style.zig").Style{};
+   const mode:u8=switch(style.fg_color){.none=>0,.palette=>1,.rgb=>2};const color:u32=switch(style.fg_color){.none=>0,.palette=>|v| v,.rgb=>|v| (@as(u32,v.r)<<16)|(@as(u32,v.g)<<8)|v.b};
+   try std.json.Stringify.value(.{.chars=tw.buffered(),.width=width,.fgMode=mode,.fgColor=color},.{},w);
+  }
+  try w.writeAll("]}");
+ }
+ try w.writeAll("]}");
+}
